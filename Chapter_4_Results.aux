\@writefile{toc}{\contentsline {section}{\numberline {4.2}Effect of Nonclassicality $\tau $}{36}{section.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time, for fixed parameters $\kappa _{1}=\kappa _{2}=\kappa =0.05$, $\mu _{1}=\mu _{2}=\mu =1$, $\phi _{1}=0$ and $\phi _{2}=\pi /2$. In each case, dotted-green, dot-dashed black, dashed-red, and solid blue lines represent $\tau _{1}=\tau _{2}=\tau =0.15$, $0.20$, $0.25$, and $0.30$, respectively.}}{37}{figure.caption.9}\protected@file@percent }
\newlabel{fig:4.2}{{4.2}{37}{Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time, for fixed parameters $\protect \kappa _{1}=\protect \kappa _{2}=\protect \kappa =0.05$, $\protect \mu _{1}=\protect \mu _{2}=\protect \mu =1$, $\protect \phi _{1}=0$ and $\protect \phi _{2}=\pi /2$. In each case, dotted-green, dot-dashed black, dashed-red, and solid blue lines represent $\protect \tau _{1}=\protect \tau _{2}=\protect \tau =0.15$, $0.20$, $0.25$, and $0.30$, respectively}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.3}Effect of Purity $\mu $}{38}{section.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time, for fixed parameters $\kappa _{1}=\kappa _{2}=\kappa =0.05$, $\tau _{1}=\tau _{2}=\tau =0.35$, $\phi _{1}=0$ and $\phi _{2}=\pi /2$. In each case, dotted-green, dot-dashed black, dashed-red, and solid blue lines represent $\mu _{1}=\mu _{2}=\mu =0.80$, $0.90$, $0.95$, and $1.0$, respectively.}}{39}{figure.caption.10}\protected@file@percent }
\newlabel{fig:mu_variation}{{4.3}{39}{Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time, for fixed parameters $\protect \kappa _{1}=\protect \kappa _{2}=\protect \kappa =0.05$, $\protect \tau _{1}=\protect \tau _{2}=\protect \tau =0.35$, $\protect \phi _{1}=0$ and $\protect \phi _{2}=\pi /2$. In each case, dotted-green, dot-dashed black, dashed-red, and solid blue lines represent $\protect \mu _{1}=\protect \mu _{2}=\protect \mu =0.80$, $0.90$, $0.95$, and $1.0$, respectively}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.4}Effect of Loss Parameter $\kappa $}{40}{section.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time, for fixed parameters $\tau _{1}=\tau _{2}=\tau =0.35$, $\phi _{1}=0$ and $\phi _{2}=\pi /2$, and $\mu _{1}=\mu _{2}=\mu =1$. In each case, dotted-green, dot-dashed black, dashed-red, and solid blue lines represent $\kappa _{1}=\kappa _{2}=\kappa =0$, $0.20$, $0.35$, and $0.60$, respectively.}}{41}{figure.caption.11}\protected@file@percent }
\newlabel{fig:4.3}{{4.4}{41}{Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time, for fixed parameters $\protect \tau _{1}=\protect \tau _{2}=\protect \tau =0.35$, $\protect \phi _{1}=0$ and $\protect \phi _{2}=\pi /2$, and $\protect \mu _{1}=\protect \mu _{2}=\protect \mu =1$. In each case, dotted-green, dot-dashed black, dashed-red, and solid blue lines represent $\protect \kappa _{1}=\protect \kappa _{2}=\protect \kappa =0$, $0.20$, $0.35$, and $0.60$, respectively}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.5}Gaussian Quantum Steering and Entanglement in Squeezed States}{42}{section.4.5}\protected@file@percent }
\newlabel{fig:4.3}{{\caption@xref {fig:4.3}{ on input line 81}}{43}{Gaussian Quantum Steering and Entanglement in Squeezed States}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time, with squeezing factor $r=0.5$. In each case, the solid blue, dashed-red, dot-dashed black, and dotted-green lines correspond to $\kappa _{1}=\kappa _{2}=\kappa =0.1$, $0.2$, $0.3$, and $0.4$, respectively.}}{44}{figure.caption.13}\protected@file@percent }
\newlabel{fig:4.4}{{4.5}{44}{Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time, with squeezing factor $r=0.5$. In each case, the solid blue, dashed-red, dot-dashed black, and dotted-green lines correspond to $\protect \kappa _{1}=\protect \kappa _{2}=\protect \kappa =0.1$, $0.2$, $0.3$, and $0.4$, respectively}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.6}Effect of coupling strength on Quantum Steering and Entanglement}{45}{section.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time $\kappa t$ for different coupling strengths $J$/$\kappa $=$4.5$, $6$, and $7.5$. In each panel, the solid-blue curve represents the entanglement $E_N$, while the dashed-red curve represents the Gaussian steering $S_{1\rightarrow 2}$.}}{46}{figure.caption.14}\protected@file@percent }
\newlabel{fig:4.5}{{4.6}{46}{Two kinds of quantum correlations: (a) quantum steering and (b) quantum entanglement are plotted against dimensionless interaction time $\kappa t$ for different coupling strengths $J$/$\kappa $=$4.5$, $6$, and $7.5$. In each panel, the solid-blue curve represents the entanglement $E_N$, while the dashed-red curve represents the Gaussian steering $S_{1\rightarrow 2}$}{figure.caption.14}{}}
